# Fynd — /start and /call funnel pages
# Copy to .env.local for development. In production set these in the Vercel
# project's Environment Variables — never commit real keys.

# --- Stripe (required for /start checkout) ---------------------------------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_REVIEW_97=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- GoHighLevel -----------------------------------------------------------
# Inbound webhook that receives checkout/booking events.
GHL_INBOUND_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...
# Calendar id for the /call booking embed. Public — used client-side.
NEXT_PUBLIC_GHL_CALENDAR_ID=

# --- Demo video ------------------------------------------------------------
# YouTube id for the VSL. Until this is set, the demo shows a placeholder
# poster labelled "Demo coming soon" and no iframe is loaded.
NEXT_PUBLIC_VSL_EMBED_ID=

# --- Offer link signing (optional but recommended) -------------------------
# When set, the `exp` deadline param must carry a matching `sig` HMAC or the
# page falls back to the cohort deadline. Leave unset to accept `exp` unsigned.
OFFER_HMAC_SECRET=
