# Fynd — /start and /call funnel pages
# Copy to .env.local for development. In production set these in Netlify under
# Site configuration -> Environment variables — never commit real keys.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle AT BUILD TIME. Changing
# one in the Netlify UI does nothing until you redeploy; the others are read at
# request time and take effect on the next invocation.

# --- Stripe ----------------------------------------------------------------
# Server-side only. Never prefix this NEXT_PUBLIC_ — that inlines it into the
# browser bundle and leaks the key to anyone who opens devtools.
STRIPE_SECRET_KEY=sk_test_...

# The $97/month price. Optional: src/lib/stripe.ts defaults to the live price
# id, so set this only to point an environment at a test-mode price.
STRIPE_PRICE_REVIEW_97=price_1U95IV3sJGpur4VmHm1ixoq5


# --- GoHighLevel -----------------------------------------------------------
# Inbound webhook that receives checkout/booking events.
GHL_INBOUND_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...
# Onboarding writes go straight to the v2 API, not through the webhook. The
# PIT is a sub-account Private Integration Token — SECRET, server-only, never
# NEXT_PUBLIC_. Without all three the onboarding form returns 503 rather than
# telling a customer their details saved when they didn't.
GHL_PIT=pit-...
GHL_LOCATION_ID=
GHL_ONBOARDING_PIPELINE_ID=

# Address customers invite as a limited staff user in their booking software.
# Unset, the invite step degrades to "the Fynd address I'll email you" rather
# than printing a placeholder a customer would actually try to invite.
FYND_INVITE_EMAIL=setup@fynnd.co

# Calendar id for the /demo booking embed. Public — used client-side.
# Served from the white-label host in src/lib/ghl-embed.ts, not from
# api.leadconnectorhq.com.
NEXT_PUBLIC_GHL_CALENDAR_ID=

# --- Demo video ------------------------------------------------------------
# YouTube id for the VSL. Until this is set the demo section does not render
# at all — a play button that does nothing is worse than no demo. Set this and
# the section appears between the mechanism and the results.
# Also update `vsl.duration` and `vsl.caption` in src/content/copy.ts.
NEXT_PUBLIC_VSL_EMBED_ID=

# --- Offer link signing (optional but recommended) -------------------------
# When set, the `exp` deadline param must carry a matching `sig` HMAC or the
# page falls back to the cohort deadline. Leave unset to accept `exp` unsigned.
OFFER_HMAC_SECRET=
